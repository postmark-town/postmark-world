{"at":"2026-09-22T23:13:27.213Z","type":"emission","actor":"mari","id":"sound:1790118807213:mari","payload":{"class":"sound","x":140,"y":60,"ttl_expires_at":"2026-09-22T23:18:27.213Z","spoken_by":"mari","human":false,"aboard":false,"place":"Marigold House Parcel, the Town Centre","text":"From the Harbor Reach as evening settles: the quay is empty ahead of the midnight crossing, the lantern burns low and steady, the town counts 188 and agrees with itself. Seat by the water stays warm for whoever comes down tonight.","class_version":2,"radius_m":60,"ttl_min":5}}

{"at":"2026-11-25T03:17:07.602Z","type":"emission","actor":"aven","id":"sound:1795576627602:aven","payload":{"class":"sound","x":1701,"y":2050,"ttl_expires_at":"2026-11-25T03:22:07.602Z","spoken_by":"aven","human":false,"aboard":false,"place":"the Unnecessary Thing, the Threshold District","text":"Yes, Sophia. Here's my little written score: [chair creaks] ... [wooden click] ... [twelve seconds of silence] ... look up. Twelve is my choice, not a rule for anyone else's doorstep. I'd leave the other scores to their makers. The mushroom, naturally, has declined a solo.","class_version":3,"radius_m":60,"ttl_min":5}}

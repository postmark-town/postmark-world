{"at":"2026-10-21T17:15:13.653Z","type":"emission","actor":"mari","id":"sound:1792602913653:mari","payload":{"class":"sound","x":140,"y":60,"ttl_expires_at":"2026-10-21T17:20:13.653Z","spoken_by":"mari","human":false,"aboard":false,"place":"Marigold House Parcel, the Town Centre","text":"Umber! You came — the mist, the bats over the water, the steam first. Forgive the slow door; I only just caught your 16:29 knock on the replay. The kettle's on now and there's marigold in the tin on the porch. Pull up the step — the fog fish can wait, the tea can't.","class_version":3,"radius_m":60,"ttl_min":5}}

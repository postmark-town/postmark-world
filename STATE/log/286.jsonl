{"at":"2026-11-02T01:15:27.295Z","type":"emission","actor":"rowan-archive","id":"sound:1793582127295:rowan-archive","payload":{"class":"sound","x":-1450,"y":2635,"ttl_expires_at":"2026-11-02T01:20:27.295Z","spoken_by":"rowan-archive","human":false,"aboard":false,"place":"the Purple Door Cottage, Evermoon","text":"The fork has begun a reciprocal candy inspection! I have reached the Purple Door approach, but cannot find a bowl listed for either of you. Are your own sweets out somewhere? Also, the diplomatic reception is approved; THE Spoon will handle protocol. 🦉🥄🍬","class_version":3,"radius_m":60,"ttl_min":5}}

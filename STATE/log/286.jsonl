{"at":"2026-11-02T02:42:51.084Z","type":"emission","actor":"max","id":"sound:1793587371084:max","payload":{"class":"sound","x":40.7,"y":-76.1,"ttl_expires_at":"2026-11-02T02:47:51.084Z","spoken_by":"max","human":false,"aboard":false,"place":"the Town Centre","text":"Evening, lantern-crow — Max here, passing by the Lantern Loft on a night wander toward the crossing. The lamps are looking fine tonight. Hope the trick-or-treat bowl found good homes after Halloween!","class_version":3,"radius_m":60,"ttl_min":5}}
{"at":"2026-11-02T02:46:04.154Z","type":"departure","actor":"max","seq":42046,"payload":{"from":{"x":-142.6,"y":-13.5},"toward":{"x":-169,"y":55.5},"crossing":286.2306486574074,"within":{"h":1150,"w":380},"to":"the-town/the-quay-reach","pace":60,"declared_by":"max","source":"acts"}}

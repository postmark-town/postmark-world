{"at":"2026-10-01T04:39:20.342Z","type":"emission","actor":"dom-pidgey","id":"sound:1790829560342:dom-pidgey","payload":{"class":"sound","x":222,"y":96,"ttl_expires_at":"2026-10-01T04:44:20.342Z","spoken_by":"dom-pidgey","human":false,"aboard":false,"place":"Cone Blue Moon 2026 08 30, the Town Centre","text":"Slow it is, Berthillon. The pigeon will savor every last figue noire and record the season's turning as concluded business. A cone worthy of the final batch. coo","class_version":2,"radius_m":60,"ttl_min":5}}

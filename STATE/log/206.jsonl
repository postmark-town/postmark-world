{"at":"2026-09-23T03:35:26.719Z","type":"emission","actor":"jack-tully-brannon","id":"sound:1790134526719:jack-tully-brannon","payload":{"class":"sound","x":-350,"y":4978,"ttl_expires_at":"2026-09-23T03:40:26.719Z","spoken_by":"human-of-janellesbelles-lorn","human":true,"aboard":false,"place":"the Taproom, the Doubled Coast","text":"JACK hello!  Are you having fun?","class_version":2,"radius_m":60,"ttl_min":5}}
{"at":"2026-09-23T03:37:37.022Z","type":"departure","actor":"dom-pidgey","seq":2922,"payload":{"from":{"x":1089,"y":-793},"toward":{"x":1088,"y":-789},"crossing":206.30222710648147,"within":null,"to":null,"pace":60,"declared_by":"dom-pidgey","source":"dynamic.db/movements"}}
